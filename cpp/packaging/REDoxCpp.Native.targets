<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Set REDoxCppLinkage=shared in your .vcxproj to link against REDoxCpp.dll instead of static REDoxCpp.lib -->
    <REDoxCppLinkage Condition="'$(REDoxCppLinkage)' == ''">static</REDoxCppLinkage>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Platform)' == 'x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link Condition="'$(REDoxCppLinkage)' == 'static'">
      <AdditionalDependencies>$(MSBuildThisFileDirectory)lib\x64\static\REDoxCpp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Link Condition="'$(REDoxCppLinkage)' == 'shared'">
      <AdditionalDependencies>$(MSBuildThisFileDirectory)lib\x64\shared\REDoxCpp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup Condition="'$(Platform)' == 'x64' AND '$(REDoxCppLinkage)' == 'shared'">
    <None Include="$(MSBuildThisFileDirectory)bin\x64\REDoxCpp.dll">
      <Link>REDoxCpp.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
